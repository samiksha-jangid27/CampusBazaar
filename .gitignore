# ------------------------------
# Monorepo-wide ignore rules
# ------------------------------

# Dependencies
node_modules/
**/node_modules/

# Build and cache output
dist/
build/
coverage/
.cache/

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Environment and secrets
.env
.env.*
!.env.example
!.env.*.example

# OS and editor files
.DS_Store
Thumbs.db
.idea/
.vscode/

# ------------------------------
# Backend (Node + Prisma)
# ------------------------------
backend/src/generated/prisma/
backend/prisma/dev.db

# ------------------------------
# Mobile (Expo / React Native)
# ------------------------------
mobile/.expo/
mobile/.expo-shared/
mobile/dist/
mobile/web-build/
mobile/expo-env.d.ts
mobile/.metro-health-check*
mobile/.kotlin/
mobile/android/
mobile/ios/

# Native signing artifacts
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# TypeScript
*.tsbuildinfo
